<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0-windows + WinForms: the native folder-browse dialog (FolderBrowserDialog) is
         Windows-only, which is consistent with the settled "Excel on Windows is the target"
         decision and the already-Windows-only local storage provider. See docs/decisions.md. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
